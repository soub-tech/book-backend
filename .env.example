# Server
PORT=5000
NODE_ENV=development
# Your Lovable app's URL (comma-separate multiple origins if needed)
CLIENT_URL=https://grow-read-prosper.lovable.app
# true because the Lovable frontend and this API are on different domains
COOKIE_CROSS_ORIGIN=true

# Database (Postgres in prod; see prisma/schema.prisma). For quick local start, SQLite works too.
DATABASE_URL="postgresql://user:password@localhost:5432/bookapp?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password reset
RESET_TOKEN_EXPIRES_MIN=30

# Email (for password reset / receipts) - fill in with real SMTP creds
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=changeme
EMAIL_FROM="Book App <no-reply@example.com>"

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
